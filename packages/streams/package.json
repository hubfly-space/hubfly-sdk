{
  "name": "@hubfly/streams",
  "version": "0.1.0",
  "description": "JavaScript SDK for HubFly Managed Streams: browser player, WHIP publishing, playback tokens and webhook verification.",
  "homepage": "https://github.com/hubfly-space/hubfly-sdk/tree/main/packages/streams#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubfly-space/hubfly-sdk.git",
    "directory": "packages/streams"
  },
  "bugs": {
    "url": "https://github.com/hubfly-space/hubfly-sdk/issues"
  },
  "author": "Hubfly Cloud Platform",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/player.js",
    "./dist/player.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./player": {
      "import": {
        "types": "./dist/player.d.ts",
        "default": "./dist/player.js"
      },
      "require": {
        "types": "./dist/player.d.cts",
        "default": "./dist/player.cjs"
      }
    },
    "./publish": {
      "import": {
        "types": "./dist/publish.d.ts",
        "default": "./dist/publish.js"
      },
      "require": {
        "types": "./dist/publish.d.cts",
        "default": "./dist/publish.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hubfly",
    "live",
    "streaming",
    "webrtc",
    "whep",
    "whip",
    "hls",
    "player"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "hls.js": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
